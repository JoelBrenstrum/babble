# The URL people use to reach Babble. Must be HTTPS for PWA install and Web Push.
PUBLIC_URL=https://babble.example.com

# From Supabase: Project Settings → API (Cloud) or your self-hosted .env (ANON_KEY).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Show "Continue with Google" (also enable the Google provider in Supabase Auth).
GOOGLE_AUTH_ENABLED=false
BILLING_ENABLED=false

BABBLE_PORT=3000
